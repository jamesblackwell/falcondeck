+// AX node ids are local to a CDP frame/target. Joining multiple frame trees
+// must not turn matching ids into links between unrelated documents.
+type AxKey<'a> = (Option<&'a str>, Option<&'a str>, Option<&'a str>, &'a str);
+
+fn ax_key<'a>(frame: &'a FrameRef, ax_id: &'a str) -> AxKey<'a> {
+    (
+        frame.oopif_target_id.as_deref(),
+        frame
+            .identity
+            .as_ref()
+            .map(|identity| identity.frame_id.as_str()),
+        frame
+            .identity
+            .as_ref()
+            .map(|identity| identity.loader_id.as_str()),
+        ax_id,
+    )
+}
