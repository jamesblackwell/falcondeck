# Repo-local autoreview defaults. Shell env and explicit CLI flags still win.
AUTOREVIEW_ENGINE=opencode
AUTOREVIEW_OPENCODE_MODEL=zai-coding-plan/glm-5.2
AUTOREVIEW_OPENCODE_DOPPLER_PROJECT=quizgecko
AUTOREVIEW_OPENCODE_DOPPLER_CONFIG=ops
AUTOREVIEW_OPENCODE_DOPPLER_SECRET=ZAI_API_KEY
AUTOREVIEW_OPENCODE_DOPPLER_ENV=ZHIPU_API_KEY
