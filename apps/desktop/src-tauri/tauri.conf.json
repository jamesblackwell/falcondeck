{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FalconDeck",
  "version": "0.1.0",
  "identifier": "com.falcondeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run extension-runtime:prepare --prefix ../.. && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../../../crates/falcondeck-core",
      "../../../crates/falcondeck-daemon"
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/deno"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "FalconDeck",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#09090b",
        "width": 1520,
        "height": 980,
        "minWidth": 1120,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost blob: data: https:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* http: https: ws: wss:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "__FALCONDECK_UPDATER_PUBLIC_KEY__",
      "endpoints": [
        "https://github.com/jamesblackwell/falcondeck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
