{
  "name": "falcondeck-remote-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4174 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@falcondeck/chat-ui": "file:../../packages/chat-ui",
    "@falcondeck/client-core": "file:../../packages/client-core",
    "@falcondeck/extension-sdk": "file:../../packages/extension-sdk",
    "@falcondeck/ui": "file:../../packages/ui",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.3",
    "@rolldown/binding-darwin-x64": "1.2.3",
    "@rolldown/binding-linux-x64-gnu": "1.2.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
