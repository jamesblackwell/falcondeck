{{ falcondeck_app_domain }} {
  encode zstd gzip

  tls {{ falcondeck_tls_email }}

  header {
    Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Strict-Transport-Security "max-age=31536000"
    -Server
  }

  root * /var/www/falcondeck-app
  @app_assets path /assets/*
  header @app_assets Cache-Control "public, max-age=31536000, immutable"
  @app_html path / /index.html
  header @app_html Cache-Control "no-store, must-revalidate"
  try_files {path} /index.html
  file_server
}

{{ falcondeck_relay_domain }} {
  encode zstd gzip

  tls {{ falcondeck_tls_email }}

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Strict-Transport-Security "max-age=31536000"
    -Server
  }

  handle_path /dist/* {
    root * {{ falcondeck_dist_dir }}
    @dist_binary not path *.sha256
    @dist_checksum path *.sha256
    header @dist_binary Content-Type application/octet-stream
    header @dist_checksum Content-Type "text/plain; charset=utf-8"
    file_server
  }

  handle {
    reverse_proxy 127.0.0.1:{{ falcondeck_relay_port }}
  }
}

{{ falcondeck_site_domain }} {
  encode zstd gzip

  tls {{ falcondeck_tls_email }}

  root * /var/www/falcondeck-site
  @site_assets path /assets/*
  header @site_assets Cache-Control "public, max-age=31536000, immutable"
  @site_html path / /index.html
  header @site_html Cache-Control "no-store, must-revalidate"
  try_files {path} /index.html
  file_server
}
