{{ falcondeck_app_domain }} {
  encode zstd gzip

  tls {{ falcondeck_tls_email }}

  header {
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Strict-Transport-Security "max-age=31536000"
    -Server
  }

  # Pairing QR codes used to target this host. Serve the public site so a
  # camera scan opens the mobile app (or the get-the-app page), not a web client.
  @aasa path /.well-known/apple-app-site-association /apple-app-site-association
  handle @aasa {
    root * /var/www/falcondeck-site
    header Content-Type "application/json"
    file_server
  }

  handle {
    root * /var/www/falcondeck-site
    @app_assets path /assets/*
    header @app_assets Cache-Control "public, max-age=31536000, immutable"
    @app_html path / /index.html /pair /pair/
    header @app_html Cache-Control "no-store, must-revalidate"
    try_files {path} /index.html
    file_server
  }
}

{{ falcondeck_relay_domain }} {
  encode zstd gzip

  tls {{ falcondeck_tls_email }}

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Strict-Transport-Security "max-age=31536000"
    -Server
  }

  handle_path /dist/* {
    root * {{ falcondeck_dist_dir }}
    @dist_binary not path *.sha256
    @dist_checksum path *.sha256
    header @dist_binary Content-Type application/octet-stream
    header @dist_checksum Content-Type "text/plain; charset=utf-8"
    file_server
  }

  handle {
    reverse_proxy 127.0.0.1:{{ falcondeck_relay_port }}
  }
}

{{ falcondeck_site_domain }} {
  encode zstd gzip

  tls {{ falcondeck_tls_email }}

  @aasa path /.well-known/apple-app-site-association /apple-app-site-association
  handle @aasa {
    root * /var/www/falcondeck-site
    header Content-Type "application/json"
    file_server
  }

  handle {
    root * /var/www/falcondeck-site
    @site_assets path /assets/*
    header @site_assets Cache-Control "public, max-age=31536000, immutable"
    @site_html path / /index.html /pair /pair/
    header @site_html Cache-Control "no-store, must-revalidate"
    try_files {path} /index.html
    file_server
  }
}
