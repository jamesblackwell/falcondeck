{
  "$schema": "../../../schemas/extension-manifest.schema.json",
  "id": "falcondeck.notes",
  "name": "Notes",
  "version": "0.3.0",
  "engines": {
    "falcondeck": "^0.1"
  },
  "entrypoint": "server.ts",
  "frontend": "app.tsx",
  "contributes": {
    "threadMenuActions": [
      {
        "id": "notes",
        "title": "Notes"
      }
    ],
    "panels": [
      {
        "id": "library",
        "title": "Notes",
        "view": "notes",
        "icon": "notebook-pen",
        "ui": {
          "version": 1,
          "root": {
            "type": "stack",
            "gap": "large",
            "children": [
              {
                "type": "text",
                "text": "Notes",
                "style": "heading"
              },
              {
                "type": "text",
                "text": "A quiet place for Markdown notes.",
                "tone": "muted"
              },
              { "type": "divider" },
              {
                "type": "state",
                "state": "empty",
                "title": "No notes yet",
                "description": "Open Notes on desktop or in the browser to write."
              }
            ]
          }
        }
      }
    ]
  },
  "permissions": []
}
