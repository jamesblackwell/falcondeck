{
  "$schema": "../../../schemas/extension-manifest.schema.json",
  "id": "falcondeck.missions",
  "name": "Missions",
  "version": "0.4.1",
  "engines": {
    "falcondeck": "^0.1"
  },
  "entrypoint": "server.ts",
  "frontend": "app.tsx",
  "contributes": {
    "panelActions": [
      { "id": "refresh-missions", "title": "Refresh missions" },
      { "id": "start-draft", "title": "Start mission draft" },
      { "id": "update-draft", "title": "Edit mission draft" },
      { "id": "adopt-task", "title": "Start mission from task" },
      { "id": "pause-run", "title": "Pause mission" },
      { "id": "resume-run", "title": "Resume mission" },
      { "id": "extend-run", "title": "Extend mission deadline" },
      { "id": "accept-completion", "title": "Accept mission completion" },
      { "id": "close-incomplete", "title": "Close mission incomplete" }
    ],
    "panels": [
      {
        "id": "missions",
        "title": "Missions",
        "view": "missions-panel",
        "icon": "activity"
      }
    ],
    "agentTools": [
      {
        "id": "draft-mission",
        "title": "Start a FalconDeck Mission draft",
        "description": "Use this when the user explicitly asks to start, create, or run a FalconDeck Mission. Create a bounded draft for this exact task before doing the requested work; do not substitute a harness goal or merely describe a mission. Include the agreed time, coordinator-turn, and worker limits as structured fields. A human must review and start it before automatic work begins.",
        "inputSchema": {
          "type": "object",
          "required": ["objective"],
          "properties": {
            "title": { "type": "string", "maxLength": 120 },
            "objective": { "type": "string", "maxLength": 12000 },
            "acceptanceCriteria": {
              "type": "array",
              "maxItems": 12,
              "items": { "type": "string", "maxLength": 500 }
            },
            "leaseMinutes": {
              "type": "integer",
              "minimum": 15,
              "maximum": 1440,
              "description": "Hard runtime deadline in minutes. Defaults to 180."
            },
            "maxAutomaticTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "description": "Hard coordinator-turn budget. Defaults to 12."
            },
            "maxWorkers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4,
              "description": "Hard worker-task budget. Defaults to 3."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "id": "mission-status",
        "title": "Read this task's mission",
        "description": "Read the bounded Mission state owned by this exact coordinator task, including its remaining automatic-turn allowance and deadline.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "id": "mission-delegate",
        "title": "Delegate one Mission worker",
        "description": "Delegate one independent, bounded assignment to a separate Codex worker task. The human-approved Mission budget permits at most four workers and FalconDeck runs them serially.",
        "inputSchema": {
          "type": "object",
          "required": ["assignment"],
          "properties": {
            "assignment": { "type": "string", "maxLength": 12000 }
          },
          "additionalProperties": false
        }
      },
      {
        "id": "mission-checkpoint",
        "title": "Checkpoint a FalconDeck mission",
        "description": "Persist meaningful Mission progress, request one bounded continuation, pause for human input, or propose evidence-backed completion for human acceptance.",
        "inputSchema": {
          "type": "object",
          "required": ["disposition", "summary"],
          "properties": {
            "disposition": {
              "type": "string",
              "enum": ["continue_self", "awaiting_workers", "needs_human", "proposing_completion"]
            },
            "summary": { "type": "string", "maxLength": 4000 },
            "nextAction": { "type": "string", "maxLength": 2000 },
            "progressFingerprint": { "type": "string", "maxLength": 256 },
            "evidence": {
              "type": "array",
              "maxItems": 20,
              "items": { "type": "string", "maxLength": 1000 }
            },
            "limitations": {
              "type": "array",
              "maxItems": 12,
              "items": { "type": "string", "maxLength": 1000 }
            },
            "humanQuestion": { "type": "string", "maxLength": 1000 }
          },
          "additionalProperties": false
        }
      }
    ]
  },
  "permissions": [
    "threads:read",
    "agent-tools:register",
    "orchestration:manage-owned-tasks"
  ]
}
