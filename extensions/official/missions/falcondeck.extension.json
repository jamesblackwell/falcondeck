{
  "$schema": "../../../schemas/extension-manifest.schema.json",
  "id": "falcondeck.missions",
  "name": "Missions",
  "version": "0.8.0",
  "engines": {
    "falcondeck": "^0.1"
  },
  "entrypoint": "server.ts",
  "frontend": "app.tsx",
  "contributes": {
    "panelActions": [
      { "id": "refresh-missions", "title": "Refresh missions" },
      { "id": "activate-mission", "title": "Activate mission" },
      { "id": "edit-mission", "title": "Edit mission draft" },
      { "id": "add-mission-update", "title": "Message mission" },
      { "id": "set-mission-status", "title": "Change mission status" },
      { "id": "schedule-mission-review", "title": "Schedule mission review" },
      { "id": "control-mission-automation", "title": "Control mission automation" },
      { "id": "run-mission-review", "title": "Run mission review now" }
    ],
    "panels": [
      {
        "id": "missions",
        "title": "Missions",
        "view": "missions-panel",
        "icon": "activity"
      }
    ],
    "agentTools": [
      {
        "id": "create-mission",
        "title": "Create a FalconDeck Mission draft",
        "description": "Use this when the user explicitly asks to start or create a FalconDeck Mission. Create a durable project brief linked to this exact task; do not substitute a harness goal or merely describe a mission. A human reviews and activates the draft. Deadlines are optional and there is no default lifespan.",
        "inputSchema": {
          "type": "object",
          "required": ["title", "brief", "successCriteria"],
          "properties": {
            "title": { "type": "string", "maxLength": 120 },
            "brief": { "type": "string", "maxLength": 4000 },
            "successCriteria": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "maxLength": 300 }
            },
            "deadline": {
              "type": "string",
              "description": "Optional ISO 8601 deadline chosen by the human. Omit for an open-ended Mission."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "id": "read-mission",
        "title": "Read a linked FalconDeck Mission",
        "description": "Read the durable brief, success criteria, status, linked tasks, and updates for a Mission linked to this exact task.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "missionId": { "type": "string", "maxLength": 128 }
          },
          "additionalProperties": false
        }
      },
      {
        "id": "update-mission",
        "title": "Update a linked FalconDeck Mission",
        "description": "Append a meaningful update, change a non-terminal status, link an existing FalconDeck task, or replace a draft definition. Read the Mission first. edit_definition is a full replacement and works only while the Mission is still a draft. Agents cannot activate, complete, or cancel Missions.",
        "inputSchema": {
          "type": "object",
          "required": ["operation"],
          "properties": {
            "missionId": { "type": "string", "maxLength": 128 },
            "operation": {
              "type": "string",
              "enum": [
                "add_update",
                "set_status",
                "link_thread",
                "edit_definition"
              ]
            },
            "kind": {
              "type": "string",
              "enum": ["comment", "evidence", "question", "status"]
            },
            "body": { "type": "string", "maxLength": 1000 },
            "status": {
              "type": "string",
              "enum": ["active", "waiting", "needs_human", "review", "paused"]
            },
            "workspaceId": { "type": "string", "maxLength": 256 },
            "threadId": { "type": "string", "maxLength": 256 },
            "role": {
              "type": "string",
              "enum": ["source", "work", "review"]
            },
            "title": { "type": "string", "maxLength": 120 },
            "brief": { "type": "string", "maxLength": 4000 },
            "successCriteria": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "maxLength": 300 }
            },
            "deadline": { "type": "string" }
          },
          "oneOf": [
            {
              "properties": {
                "operation": { "const": "add_update" }
              },
              "required": ["operation", "kind", "body"]
            },
            {
              "properties": {
                "operation": { "const": "set_status" }
              },
              "required": ["operation", "status"]
            },
            {
              "properties": {
                "operation": { "const": "link_thread" }
              },
              "required": ["operation", "threadId"]
            },
            {
              "properties": {
                "operation": { "const": "edit_definition" }
              },
              "required": ["operation", "title", "brief", "successCriteria"]
            }
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "permissions": ["threads:read", "agent-tools:register", "automations:manage-owned"]
}
